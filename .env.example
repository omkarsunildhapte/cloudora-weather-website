# Local dev only. Copy to .dev.vars (Cloudflare's local secret file, already
# gitignored — never commit the real one) and run `npm run worker:dev` to
# exercise worker/routes/* against these values.
#
# For production these are NOT files: set them on the Worker, either with
# `npx wrangler secret put RESEND_API_KEY` or in the Cloudflare dashboard under
# Workers & Pages -> cloudora-weather-website -> Settings -> Variables and Secrets
# (use Encrypt for the API key). See worker/lib/email.ts for how they're read.
#
# None of these belong in src/environments/*: Angular compiles those files into
# the browser bundle, so anything placed there is public.

# Resend API key — https://resend.com/api-keys. Sending permission is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address on outgoing mail. Optional — defaults to
# noreply@cloudora-weather.app. Whatever it is, the domain must be
# verified in Resend (Domains -> Add, then add the SPF/DKIM records it gives
# you to the Cloudflare zone) or every send is rejected.
MAIL_FROM=noreply@vernokasoftwaretechnology.com

# Inbox that contact-form submissions are delivered to. This is the public
# support address, served by Cloudflare Email Routing on the
# cloudora-weather.app zone (Email -> Email Routing), which forwards
# it on to a real mailbox — the domain has no mail server of its own, so
# without that route mail here bounces. Optional; the code falls back to the
# same address.
CONTACT_TO_EMAIL=support@vernokasoftwaretechnology.com

# Inbox that in-app feedback (worker/routes/feedback.ts, from the Cloudora Weather
# app) is delivered to. Optional — falls back to CONTACT_TO_EMAIL. Only set
# this if feedback should land somewhere different from contact-form messages.
FEEDBACK_TO_EMAIL=support@vernokasoftwaretechnology.com

# ---------- Upstream provider keys (proxied by worker/routes/*) ----------
# These used to be compiled into the Cloudora Weather app bundle, where anyone
# could read them out of the shipped JavaScript. They now live only here, and
# the app calls /api/owm, /api/tiles and /api/ai instead of the providers.
# Set them the same way as RESEND_API_KEY: `npx wrangler secret put <NAME>`.

# OpenWeatherMap — https://home.openweathermap.org/api_keys
# Serves /api/owm/* (current, forecast, air quality, geocoding) and /api/tiles/*.
OPENWEATHER_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey. Free tier, ~15 req/min.
# Primary provider for /api/ai.
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys. Only the $0 models are requested.
# Fallback for /api/ai when Gemini fails or is rate-limited.
OPENROUTER_API_KEY=
