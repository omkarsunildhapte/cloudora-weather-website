/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    // frontend-rules.md § 20. The codebase was already written to survive
    // these; the flags were simply never turned on, so nothing was holding it
    // there. Build, 153 unit tests and 48 worker tests all pass unchanged.
    "strict": true,
    "noImplicitOverride": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["src/app/shared/*"],
      "@pages/*": ["src/app/pages/*"],
      "@services/*": ["src/services/*"],
      "@app/*": ["src/app/*"],
      "@environments/*": ["src/environments/*"],
      "@appTypes/*": ["src/types/*"],
      "@guards/*": ["src/guards/*"],
      "@interceptors/*": ["src/interceptors/*"],
      "@constants/*": ["src/constants/*"]
    },
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "typeCheckHostBindings": true,
    // invalidBananaInBox is an extended diagnostic, not a top-level flag, and
    // ships as a warning by default — § 20 asks for it enforced.
    "extendedDiagnostics": {
      "checks": {
        "invalidBananaInBox": "error",
        "nullishCoalescingNotNullable": "error",
        "optionalChainNotNullable": "error"
      }
    }
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
