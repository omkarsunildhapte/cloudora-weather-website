{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudora-weather",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Where Angular's `outputMode: 'static'` prerender writes. Must match the
    // build output the Workers Build step produces from `npm run build`.
    "directory": "./dist/cloudora-weather-website/browser",
    // Exposed to the Worker as env.ASSETS so worker/index.ts can hand
    // non-API requests back to the static asset server.
    "binding": "ASSETS",
    // Serve /features, not /features/. Cloudflare's default
    // ("auto-trailing-slash") 307s the bare path to the slashed one, which put
    // the served URL at odds with everything that points at it: sitemap.xml
    // lists /features and SeoService's canonical says /features, so Google was
    // fetching a redirect for every entry and reading a canonical that pointed
    // at a redirecting URL. Dropping the slash makes the served address, the
    // canonical and the sitemap the same string.
    "html_handling": "drop-trailing-slash",
    // Serves the prerendered 404.html with a real 404 status. Every real route
    // is prerendered to its own file, so no SPA fallback is needed for
    // navigation — and the fallback was actively harmful: it answered every
    // unknown path with index.html and a 200, so a mistyped /sitemap.xml came
    // back as an HTML page with an OK status, which is exactly what Search
    // Console complained about.
    "not_found_handling": "404-page",
  },
  // Per-IP fair-use limits. /api/ai, /api/owm and /api/tiles front provider keys
  // with no authentication, so without these anyone could loop against them and
  // drain the free quotas. Cloudflare's binding only supports 10s and 60s
  // periods. The ceilings are approximate — see worker/lib/guard.ts.
  //
  // TILE_LIMIT is deliberately generous: playing the radar timeline requests a
  // fresh set of tiles per frame, so a legitimate session can burst a few
  // hundred in seconds. It is sized to stop bulk scraping, not panning.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "DATA_LIMIT", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "TILE_LIMIT", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": { "enabled": true },
}
