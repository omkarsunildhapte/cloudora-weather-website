{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudora-weather-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Where Angular's `outputMode: 'static'` prerender writes. Must match the
    // build output the Workers Build step produces from `npm run build`.
    "directory": "./dist/cloudora-weather-website/browser",
    // Exposed to the Worker as env.ASSETS so worker/index.ts can hand
    // non-API requests back to the static asset server.
    "binding": "ASSETS",
    // Unknown deep links render index.html and let the Angular router decide,
    // instead of Cloudflare's default 404 page.
    "not_found_handling": "single-page-application",
  },
  // Per-IP fair-use limits. /api/ai, /api/owm and /api/tiles front provider keys
  // with no authentication, so without these anyone could loop against them and
  // drain the free quotas. Cloudflare's binding only supports 10s and 60s
  // periods. The ceilings are approximate — see worker/lib/guard.ts.
  //
  // TILE_LIMIT is deliberately generous: playing the radar timeline requests a
  // fresh set of tiles per frame, so a legitimate session can burst a few
  // hundred in seconds. It is sized to stop bulk scraping, not panning.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAIL_LIMIT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "DATA_LIMIT", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "TILE_LIMIT", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": { "enabled": true },
}
